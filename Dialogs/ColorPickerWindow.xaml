<Window x:Class="CrosshairWin.Dialogs.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色"
        Width="420" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1E1E1E"
        Foreground="#FFE8E8E8"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="十六进制颜色（#RRGGBB 或 #AARRGGBB）"
                   Foreground="#FFB0B0B0" Margin="0,0,0,6" />

        <TextBox Grid.Row="1" x:Name="HexBox" Margin="0,0,0,12"
                 TextChanged="HexBox_TextChanged" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="R" Foreground="#FFB0B0B0" />
                <Slider x:Name="RSlider" Minimum="0" Maximum="255" ValueChanged="Channel_Changed" />
                <TextBlock Text="G" Foreground="#FFB0B0B0" />
                <Slider x:Name="GSlider" Minimum="0" Maximum="255" ValueChanged="Channel_Changed" />
                <TextBlock Text="B" Foreground="#FFB0B0B0" />
                <Slider x:Name="BSlider" Minimum="0" Maximum="255" ValueChanged="Channel_Changed" />
                <TextBlock Text="A" Foreground="#FFB0B0B0" />
                <Slider x:Name="ASlider" Minimum="0" Maximum="255" ValueChanged="Channel_Changed" />
            </StackPanel>

            <Border Grid.Column="1" Width="90" Margin="14,0"
                    BorderBrush="#FF3F3F46" BorderThickness="1">
                <Border x:Name="SwatchBorder" Background="Red" />
            </Border>

            <StackPanel Grid.Column="2">
                <TextBlock Text="预设颜色" Foreground="#FFB0B0B0" Margin="0,0,0,6" />
                <WrapPanel x:Name="PresetPanel" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Click="Ok_Click" MinWidth="84" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="取消" Click="Cancel_Click" MinWidth="84" Padding="12,6" />
        </StackPanel>
    </Grid>
</Window>
