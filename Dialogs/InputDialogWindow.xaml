<Window x:Class="CrosshairWin.Dialogs.InputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="400" Height="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF1E1E1E"
        Foreground="#FFE8E8E8"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Margin="0,0,0,8"
                   Foreground="#FFB0B0B0" TextWrapping="Wrap" />

        <TextBox x:Name="ValueBox" Grid.Row="1" Padding="6,5"
                 Background="#FF252526" Foreground="#FFE8E8E8"
                 BorderBrush="#FF3F3F46" CaretBrush="#FFE8E8E8" />

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,16,0,0">
            <Button Content="确定" Click="Ok_Click" IsDefault="True"
                    MinWidth="84" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="取消" Click="Cancel_Click" IsCancel="True"
                    MinWidth="84" Padding="12,6" />
        </StackPanel>
    </Grid>
</Window>
