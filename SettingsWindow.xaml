<Window x:Class="CrosshairWin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CrosshairWin.Controls"
        Title="CrosshairWin 设置"
        Width="880" Height="680"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        Foreground="#FFE8E8E8"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8E8E8" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FF9CDCFE" />
            <Setter Property="BorderBrush" Value="#FF3C3C3C" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="Margin" Value="0,4,10,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF252526" />
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="CaretBrush" Value="#FFE8E8E8" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,3" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF252526" />
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB0B0B0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ LEFT: presets ============================ -->
        <GroupBox Grid.Column="0" Header="准星预设（F9 循环切换）">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="PresetList"
                         Grid.Row="0"
                         SelectionChanged="PresetList_SelectionChanged"
                         DisplayMemberPath="Name" />

                <UniformGrid Grid.Row="1" Columns="2" Margin="0,8,0,0">
                    <Button Content="添加内置" Click="AddBuiltIn_Click" />
                    <Button Content="添加图片" Click="AddImage_Click" />
                </UniformGrid>

                <UniformGrid Grid.Row="2" Columns="3" Margin="0,6,0,0">
                    <Button Content="重命名" Click="RenamePreset_Click" />
                    <Button Content="复制" Click="DuplicatePreset_Click" />
                    <Button Content="删除" Click="DeletePreset_Click" />
                </UniformGrid>
            </Grid>
        </GroupBox>

        <!-- ============================ RIGHT: detail ============================ -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Live preview -->
            <Border Grid.Row="0"
                    Background="#FF101010"
                    BorderBrush="#FF3C3C3C"
                    BorderThickness="1"
                    Height="150"
                    Margin="0,0,0,10">
                <Grid>
                    <controls:CrosshairCanvas x:Name="PreviewCanvas" />
                    <TextBlock x:Name="PreviewHint"
                               Text="实时预览"
                               Foreground="#FF606060"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Margin="6" />
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Background="#FF252526" BorderBrush="#FF3C3C3C">
                <!-- ===================== tab: shape ===================== -->
                <TabItem Header="准星样式">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <TextBlock Text="形状" Style="{StaticResource FieldLabel}" />
                            <WrapPanel Margin="0,0,0,10">
                                <RadioButton x:Name="ShapeCross" Content="十字" GroupName="Shape"
                                             Checked="Shape_Checked" Tag="Cross" />
                                <RadioButton x:Name="ShapeDot" Content="点" GroupName="Shape"
                                             Checked="Shape_Checked" Tag="Dot" />
                                <RadioButton x:Name="ShapeCircle" Content="圆" GroupName="Shape"
                                             Checked="Shape_Checked" Tag="Circle" />
                                <RadioButton x:Name="ShapeT" Content="T 形" GroupName="Shape"
                                             Checked="Shape_Checked" Tag="TShape" />
                                <RadioButton x:Name="ShapeCrossDot" Content="十字+中心点" GroupName="Shape"
                                             Checked="Shape_Checked" Tag="CrossDot" />
                                <RadioButton x:Name="ShapeImage" Content="自定义图片" GroupName="Shape"
                                             Checked="Shape_Checked" Tag="Image" />
                            </WrapPanel>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="颜色" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" x:Name="ColorBox" TextChanged="ColorBox_TextChanged"
                                         ToolTip="格式 #AARRGGBB 或 #RRGGBB" />
                                <Button Grid.Column="2" Content="选择" Click="PickColor_Click" Margin="6,0,0,0" MinWidth="52" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="透明度" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" x:Name="OpacitySlider"
                                        Minimum="0" Maximum="1" Value="1"
                                        ValueChanged="OpacitySlider_ValueChanged" />
                                <TextBlock Grid.Column="2" x:Name="OpacityText" Text="100%" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="大小" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" x:Name="SizeSlider" Minimum="4" Maximum="200"
                                        ValueChanged="SizeSlider_ValueChanged" />
                                <TextBlock Grid.Column="2" x:Name="SizeText" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="线宽" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" x:Name="ThicknessSlider" Minimum="1" Maximum="20"
                                        ValueChanged="ThicknessSlider_ValueChanged" />
                                <TextBlock Grid.Column="2" x:Name="ThicknessText" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="中心间隙" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" x:Name="GapSlider" Minimum="0" Maximum="100"
                                        ValueChanged="GapSlider_ValueChanged" />
                                <TextBlock Grid.Column="2" x:Name="GapText" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="点/圆半径" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" x:Name="RadiusSlider" Minimum="1" Maximum="100"
                                        ValueChanged="RadiusSlider_ValueChanged" />
                                <TextBlock Grid.Column="2" x:Name="RadiusText" VerticalAlignment="Center" />
                            </Grid>

                            <CheckBox x:Name="OutlineCheck" Content="显示描边（提高对比度）"
                                      Checked="OutlineCheck_Changed" Unchecked="OutlineCheck_Changed" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===================== tab: image ===================== -->
                <TabItem Header="图片准星">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <TextBlock Text="把图片文件直接拖到本窗口，即可导入为新预设。"
                                       Foreground="#FF9CDCFE" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <TextBlock Text="推荐使用透明 PNG。支持 PNG / JPG / JPEG / BMP / GIF / TIFF / ICO。"
                                       Foreground="#FF8A8A8A" Margin="0,0,0,10" TextWrapping="Wrap" />

                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="选择图片..." Click="PickImage_Click" />
                                <Button Content="更换当前图片" Click="ReplaceImage_Click" />
                                <Button Content="打开图片目录" Click="OpenImagesFolder_Click" />
                            </WrapPanel>

                            <Border Background="#FF252526" BorderBrush="#FF3F3F46" BorderThickness="1"
                                    Padding="8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="当前图片：" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="ImagePathText" Text="（未设置）"
                                               Foreground="#FFE8E8E8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="缩放方式" Style="{StaticResource FieldLabel}" />
                            <WrapPanel Margin="0,0,0,6">
                                <RadioButton x:Name="ScalePixels" Content="按像素宽度" GroupName="Scale"
                                             Checked="ScaleMode_Checked" Tag="Pixels" />
                                <RadioButton x:Name="ScalePercent" Content="按屏幕高度百分比" GroupName="Scale"
                                             Checked="ScaleMode_Checked" Tag="ScreenPercent" />
                            </WrapPanel>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="宽度 (px)" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" x:Name="ImageWidthSlider" Minimum="8" Maximum="1024"
                                        ValueChanged="ImageWidthSlider_ValueChanged" />
                                <TextBlock Grid.Column="2" x:Name="ImageWidthText" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="屏幕高度 (%)" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" x:Name="ImagePercentSlider" Minimum="1" Maximum="100"
                                        ValueChanged="ImagePercentSlider_ValueChanged" />
                                <TextBlock Grid.Column="2" x:Name="ImagePercentText" VerticalAlignment="Center" />
                            </Grid>

                            <CheckBox x:Name="KeepAspectCheck" Content="保持宽高比"
                                      Checked="KeepAspect_Changed" Unchecked="KeepAspect_Changed" />
                            <CheckBox x:Name="LockRatioCheck" Content="锁定比例（调整时同步缩放）"
                                      Checked="LockRatio_Changed" Unchecked="LockRatio_Changed" />
                            <CheckBox x:Name="CenterAnchorCheck" Content="以中心为锚点对齐"
                                      Checked="CenterAnchor_Changed" Unchecked="CenterAnchor_Changed" />

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="旋转 (0-360)" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" x:Name="RotationSlider" Minimum="0" Maximum="360"
                                        ValueChanged="RotationSlider_ValueChanged" />
                                <TextBlock Grid.Column="2" x:Name="RotationText" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="图片透明度" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" x:Name="ImageOpacitySlider" Minimum="0" Maximum="1"
                                        ValueChanged="ImageOpacitySlider_ValueChanged" />
                                <TextBlock Grid.Column="2" x:Name="ImageOpacityText" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="水平偏移 (px)" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" x:Name="OffsetXSlider" Minimum="-500" Maximum="500"
                                        ValueChanged="OffsetXSlider_ValueChanged" />
                                <TextBlock Grid.Column="2" x:Name="OffsetXText" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="垂直偏移 (px)" Style="{StaticResource FieldLabel}" />
                                <Slider Grid.Column="1" x:Name="OffsetYSlider" Minimum="-500" Maximum="500"
                                        ValueChanged="OffsetYSlider_ValueChanged" />
                                <TextBlock Grid.Column="2" x:Name="OffsetYText" VerticalAlignment="Center" />
                            </Grid>

                            <CheckBox x:Name="OriginalColorCheck" Content="原色显示（取消则使用单色着色）"
                                      Checked="OriginalColor_Changed" Unchecked="OriginalColor_Changed" />

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="着色颜色" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" x:Name="TintColorBox" TextChanged="TintColorBox_TextChanged" />
                                <Button Grid.Column="2" Content="选择" Click="PickTintColor_Click" Margin="6,0,0,0" MinWidth="52" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===================== tab: position ===================== -->
                <TabItem Header="位置与显示">
                    <StackPanel Margin="10">
                        <TextBlock Text="目标显示器" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <ComboBox x:Name="MonitorCombo"
                                  SelectionChanged="MonitorCombo_SelectionChanged"
                                  DisplayMemberPath="DisplayLabel"
                                  MinWidth="320" />

                        <TextBlock Text="选择“主显示器”即跟随系统主屏；显示器被拔出时会自动回退到主屏。"
                                   Foreground="#FF8A8A8A" TextWrapping="Wrap" Margin="0,8,0,14" />

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="水平偏移 (px)" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" x:Name="ScreenOffsetXSlider" Minimum="-500" Maximum="500"
                                    ValueChanged="ScreenOffsetXSlider_ValueChanged" />
                            <TextBlock Grid.Column="2" x:Name="ScreenOffsetXText" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="垂直偏移 (px)" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" x:Name="ScreenOffsetYSlider" Minimum="-500" Maximum="500"
                                    ValueChanged="ScreenOffsetYSlider_ValueChanged" />
                            <TextBlock Grid.Column="2" x:Name="ScreenOffsetYText" VerticalAlignment="Center" />
                        </Grid>

                        <CheckBox x:Name="VisibleCheck" Content="启动时显示准星"
                                  Checked="VisibleCheck_Changed" Unchecked="VisibleCheck_Changed" />
                        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动"
                                  Checked="AutoStartCheck_Changed" Unchecked="AutoStartCheck_Changed" />
                        <CheckBox x:Name="NotifyCheck" Content="显示托盘通知"
                                  Checked="NotifyCheck_Changed" Unchecked="NotifyCheck_Changed" />
                    </StackPanel>
                </TabItem>

                <!-- ===================== tab: hotkeys ===================== -->
                <TabItem Header="快捷键">
                    <StackPanel Margin="10">
                        <TextBlock Text="点击输入框后按下想要的组合键。留空表示不修改。"
                                   Foreground="#FF8A8A8A" Margin="0,0,0,12" TextWrapping="Wrap" />

                        <Grid x:Name="HotkeyGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="显示/隐藏" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="HotkeyToggleBox" Margin="0,3"
                                     IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Tag="ToggleVisibility" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="默认 F8" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="切换准星" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="HotkeyCycleBox" Margin="0,3"
                                     IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Tag="CyclePreset" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="默认 F9" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="打开设置" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="HotkeySettingsBox" Margin="0,3"
                                     IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Tag="OpenSettings" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="默认 F10" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="退出程序" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="HotkeyExitBox" Margin="0,3"
                                     IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Tag="Exit" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="默认 Ctrl+Alt+Q" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
                        </Grid>

                        <Button Content="恢复默认快捷键" Click="ResetHotkeys_Click"
                                HorizontalAlignment="Left" Margin="0,16,0,0" />

                        <TextBlock x:Name="HotkeyStatusText"
                                   Foreground="#FFFFA500"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- ===================== bottom bar ===================== -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="保存" Click="Save_Click" />
                <Button Content="取消" Click="Cancel_Click" />
                <Button Content="恢复默认设置" Click="RestoreDefaults_Click" />
                <Button Content="导出配置" Click="Export_Click" />
                <Button Content="导入配置" Click="Import_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
