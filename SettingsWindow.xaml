<!--
    CrosshairWin settings window - visual design.

    Design goals:
      * Clean dark theme with a clear hierarchy instead of the previous flat grey boxes.
      * A slider row style that pairs a label, a slider and a live value read-out, so
        the numeric feedback is always visible and never wraps.
      * Subtle accent colour used only for emphasis (selected items, focus, headers).
      * Every x:Name and event handler from the original layout is preserved; the
        control-backing code expects all 55 names and 45 handlers to exist.
-->
<Window x:Class="CrosshairWin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CrosshairWin.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1000" d:DesignHeight="720"
        Title="CrosshairWin 设置"
        Icon="Assets/app.ico"
        Width="1000" Height="720"
        MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#FF14161A"
        Foreground="#FFE6E8EC"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver">

    <Window.Resources>
        <!-- ============================ palette ============================ -->
        <Color x:Key="AccentColor">#FF4EA1FF</Color>
        <SolidColorBrush x:Key="Accent" Color="#FF4EA1FF" />
        <SolidColorBrush x:Key="AccentSoft" Color="#334EA1FF" />
        <SolidColorBrush x:Key="AccentDim" Color="#FF2B6CB8" />
        <SolidColorBrush x:Key="Surface0" Color="#FF14161A" />
        <SolidColorBrush x:Key="Surface1" Color="#FF1C1F25" />
        <SolidColorBrush x:Key="Surface2" Color="#FF23272F" />
        <SolidColorBrush x:Key="Surface3" Color="#FF2C313A" />
        <SolidColorBrush x:Key="Hairline" Color="#FF343946" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFE6E8EC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FF9BA3B0" />
        <SolidColorBrush x:Key="TextMuted" Color="#FF6B7280" />
        <SolidColorBrush x:Key="Warn" Color="#FFFFB454" />
        <SolidColorBrush x:Key="Danger" Color="#FFFF6B6B" />
        <SolidColorBrush x:Key="Success" Color="#FF4ADE80" />

        <!-- ============================ arrow glyph for ComboBox ============================ -->
        <PathGeometry x:Key="ChevronDown" Figures="M 0,0 L 5,5 L 10,0" />

        <!-- ============================ text ============================ -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="ValueReadout" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ============================ card ============================ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface1}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- ============================ buttons ============================ -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource Surface3}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A4150" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A3038" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button (保存) -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentDim}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Compact button used inside list toolbars -->
        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ============================ text input ============================ -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{StaticResource Surface2}"
                                BorderBrush="{StaticResource Hairline}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ checkbox ============================ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="18" Height="18"
                                    Background="{StaticResource Surface2}"
                                    BorderBrush="{StaticResource Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Data="M 0,4 L 3.5,7.5 L 9,1.5"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ radio button ============================ -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,4,6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip"
                                Background="{StaticResource Surface2}"
                                BorderBrush="{StaticResource Hairline}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot"
                                         Width="8" Height="8"
                                         Fill="{StaticResource TextMuted}"
                                         VerticalAlignment="Center" />
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ slider ============================ -->
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="22">
                            <Border Height="6"
                                    CornerRadius="3"
                                    Background="{StaticResource Surface3}"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3"
                                                        Background="{StaticResource Accent}"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="6" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="#FF0E1116" Width="16" Height="16" />
                                                    <Ellipse x:Name="Knob"
                                                             Fill="White"
                                                             Width="12" Height="12" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Accent}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ combo box ============================ -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{StaticResource Surface2}"
                                                BorderBrush="{StaticResource Hairline}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Data="{StaticResource ChevronDown}"
                                                      Stroke="{StaticResource TextSecondary}"
                                                      StrokeThickness="1.6"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="8,2,12,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDim}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Focusable="False">
                                <Border Background="{StaticResource Surface2}"
                                        BorderBrush="{StaticResource Hairline}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ preset list ============================ -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{StaticResource Surface2}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Bullet"
                                         Grid.Column="0"
                                         Width="6" Height="6"
                                         Fill="{StaticResource TextMuted}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,9,0" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bullet" Property="Fill" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ tabs ============================ -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="14,8"
                                    Margin="0,0,4,0">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Underline"
                                    Height="2"
                                    Width="0"
                                    Background="{StaticResource Accent}"
                                    CornerRadius="1"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2}" />
                                <Setter TargetName="Underline" Property="Width" Value="24" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ scrollbar ============================ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" CornerRadius="5">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FF3F4655"
                                                        CornerRadius="5"
                                                        Margin="2,0"
                                                        Width="6" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ composite: labelled slider row ============================ -->
        <Style x:Key="SliderRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,5" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ header ============================ -->
        <Grid Grid.Row="0" Margin="2,0,2,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34"
                        Background="{StaticResource AccentSoft}"
                        BorderBrush="{StaticResource Accent}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,12,0">
                    <!-- small crosshair mark -->
                    <Grid>
                        <Rectangle Width="16" Height="2" Fill="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Rectangle Width="2" Height="16" Fill="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="4" Height="4" Fill="{StaticResource Surface0}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CrosshairWin" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Text="屏幕准星设置" FontSize="11.5"
                               Foreground="{StaticResource TextMuted}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="拖拽图片到窗口即可导入为新的图片准星"
                       Style="{StaticResource Hint}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       MaxWidth="320"
                       TextAlignment="Right" />
        </Grid>

        <!-- ============================ body ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: preset list -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="2,0,2,10">
                        <TextBlock Text="准星预设" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="按 F9 循环切换全部预设"
                                   Style="{StaticResource Hint}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <ListBox x:Name="PresetList"
                             Grid.Row="1"
                             SelectionChanged="PresetList_SelectionChanged"
                             DisplayMemberPath="Name" />

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="＋ 内置" Style="{StaticResource CompactButton}"
                                    HorizontalAlignment="Stretch" Click="AddBuiltIn_Click" />
                            <Button Grid.Column="2" Content="＋ 图片" Style="{StaticResource CompactButton}"
                                    HorizontalAlignment="Stretch" Click="AddImage_Click" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="重命名" Style="{StaticResource CompactButton}"
                                    HorizontalAlignment="Stretch" Click="RenamePreset_Click" />
                            <Button Grid.Column="2" Content="复制" Style="{StaticResource CompactButton}"
                                    HorizontalAlignment="Stretch" Click="DuplicatePreset_Click" />
                            <Button Grid.Column="4" Content="删除" Style="{StaticResource CompactButton}"
                                    HorizontalAlignment="Stretch" Click="DeletePreset_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: live preview and parameter tabs -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- preview -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="168" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,12,14,0">
                            <TextBlock Text="实时预览" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}" />
                            <TextBlock x:Name="PreviewHint"
                                       Text=""
                                       Style="{StaticResource Hint}"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       MaxWidth="520" />
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="14,10,14,14"
                                CornerRadius="6"
                                Background="#FF0B0D11"
                                BorderBrush="{StaticResource Hairline}"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <!-- Checkerboard suggests transparency without competing with the crosshair -->
                            <Grid>
                                <Rectangle Opacity="0.05">
                                    <Rectangle.Fill>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="#FFFFFFFF">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,16,16" />
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                    <GeometryDrawing Brush="#FF000000">
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <RectangleGeometry Rect="0,0,8,8" />
                                                                <RectangleGeometry Rect="8,8,8,8" />
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <controls:CrosshairCanvas x:Name="PreviewCanvas" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- tabs -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                    <TabControl>
                        <!-- ===================== tab: shape ===================== -->
                        <TabItem Header="准星样式">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,12,8,2">
                                <StackPanel>
                                    <TextBlock Text="形状" Style="{StaticResource SectionHeader}" />
                                    <WrapPanel Margin="0,0,0,14">
                                        <RadioButton x:Name="ShapeCross" Content="十字" GroupName="Shape"
                                                     Checked="Shape_Checked" Tag="Cross" />
                                        <RadioButton x:Name="ShapeDot" Content="点" GroupName="Shape"
                                                     Checked="Shape_Checked" Tag="Dot" />
                                        <RadioButton x:Name="ShapeCircle" Content="圆" GroupName="Shape"
                                                     Checked="Shape_Checked" Tag="Circle" />
                                        <RadioButton x:Name="ShapeT" Content="T 形" GroupName="Shape"
                                                     Checked="Shape_Checked" Tag="TShape" />
                                        <RadioButton x:Name="ShapeCrossDot" Content="十字+中心点" GroupName="Shape"
                                                     Checked="Shape_Checked" Tag="CrossDot" />
                                        <RadioButton x:Name="ShapeImage" Content="自定义图片" GroupName="Shape"
                                                     Checked="Shape_Checked" Tag="Image" />
                                    </WrapPanel>

                                    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,0,0,14" />

                                    <TextBlock Text="外观" Style="{StaticResource SectionHeader}" />

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="颜色" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" x:Name="ColorBox" TextChanged="ColorBox_TextChanged"
                                                 ToolTip="格式 #AARRGGBB 或 #RRGGBB" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="选择" Style="{StaticResource CompactButton}"
                                                Margin="8,0,0,0" HorizontalAlignment="Stretch" Click="PickColor_Click" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="透明度" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" x:Name="OpacitySlider"
                                                Minimum="0" Maximum="1" Value="1"
                                                ValueChanged="OpacitySlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" x:Name="OpacityText" Text="100%" Style="{StaticResource ValueReadout}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="大小" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" x:Name="SizeSlider" Minimum="4" Maximum="200"
                                                ValueChanged="SizeSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" x:Name="SizeText" Style="{StaticResource ValueReadout}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="线宽" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" x:Name="ThicknessSlider" Minimum="1" Maximum="20"
                                                ValueChanged="ThicknessSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" x:Name="ThicknessText" Style="{StaticResource ValueReadout}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="中心间隙" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" x:Name="GapSlider" Minimum="0" Maximum="100"
                                                ValueChanged="GapSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" x:Name="GapText" Style="{StaticResource ValueReadout}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="点/圆半径" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" x:Name="RadiusSlider" Minimum="1" Maximum="100"
                                                ValueChanged="RadiusSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" x:Name="RadiusText" Style="{StaticResource ValueReadout}" />
                                    </Grid>

                                    <CheckBox x:Name="OutlineCheck" Content="显示描边（提高对比度）"
                                              Margin="0,10,0,0"
                                              Checked="OutlineCheck_Changed" Unchecked="OutlineCheck_Changed" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===================== tab: image ===================== -->
                        <TabItem Header="图片准星">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,12,8,2">
                                <StackPanel>
                                    <Border Background="{StaticResource AccentSoft}"
                                            BorderBrush="{StaticResource AccentDim}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="把图片文件直接拖到本窗口，即可导入为新预设"
                                                       Foreground="{StaticResource TextPrimary}" FontSize="12.5" />
                                            <TextBlock Text="推荐透明 PNG。支持 PNG / JPG / JPEG / BMP / GIF / TIFF / ICO"
                                                       Style="{StaticResource Hint}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="选择图片..." Click="PickImage_Click" />
                                        <Button Content="更换当前图片" Click="ReplaceImage_Click" />
                                        <Button Content="打开图片目录" Click="OpenImagesFolder_Click" />
                                    </WrapPanel>

                                    <Border Background="{StaticResource Surface2}"
                                            BorderBrush="{StaticResource Hairline}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="当前图片" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                                            <TextBlock x:Name="ImagePathText" Text="（未设置）"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="缩放方式" Style="{StaticResource SectionHeader}" />
                                    <WrapPanel Margin="0,0,0,10">
                                        <RadioButton x:Name="ScalePixels" Content="按像素宽度" GroupName="Scale"
                                                     Checked="ScaleMode_Checked" Tag="Pixels" />
                                        <RadioButton x:Name="ScalePercent" Content="按屏幕高度百分比" GroupName="Scale"
                                                     Checked="ScaleMode_Checked" Tag="ScreenPercent" />
                                    </WrapPanel>

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="宽度 (px)" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" x:Name="ImageWidthSlider" Minimum="8" Maximum="1024"
                                                ValueChanged="ImageWidthSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" x:Name="ImageWidthText" Style="{StaticResource ValueReadout}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="屏幕高度 (%)" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" x:Name="ImagePercentSlider" Minimum="1" Maximum="100"
                                                ValueChanged="ImagePercentSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" x:Name="ImagePercentText" Style="{StaticResource ValueReadout}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="旋转 (0-360)" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" x:Name="RotationSlider" Minimum="0" Maximum="360"
                                                ValueChanged="RotationSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" x:Name="RotationText" Style="{StaticResource ValueReadout}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="图片透明度" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" x:Name="ImageOpacitySlider" Minimum="0" Maximum="1"
                                                ValueChanged="ImageOpacitySlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" x:Name="ImageOpacityText" Style="{StaticResource ValueReadout}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="水平偏移 (px)" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" x:Name="OffsetXSlider" Minimum="-500" Maximum="500"
                                                ValueChanged="OffsetXSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" x:Name="OffsetXText" Style="{StaticResource ValueReadout}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="垂直偏移 (px)" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" x:Name="OffsetYSlider" Minimum="-500" Maximum="500"
                                                ValueChanged="OffsetYSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" x:Name="OffsetYText" Style="{StaticResource ValueReadout}" />
                                    </Grid>

                                    <StackPanel Margin="0,8,0,0">
                                        <CheckBox x:Name="KeepAspectCheck" Content="保持宽高比"
                                                  Checked="KeepAspect_Changed" Unchecked="KeepAspect_Changed" />
                                        <CheckBox x:Name="LockRatioCheck" Content="锁定比例（调整时同步缩放）"
                                                  Checked="LockRatio_Changed" Unchecked="LockRatio_Changed" />
                                        <CheckBox x:Name="CenterAnchorCheck" Content="以中心为锚点对齐"
                                                  Checked="CenterAnchor_Changed" Unchecked="CenterAnchor_Changed" />
                                    </StackPanel>

                                    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,14,0,14" />

                                    <CheckBox x:Name="OriginalColorCheck" Content="原色显示（取消则使用单色着色）"
                                              Checked="OriginalColor_Changed" Unchecked="OriginalColor_Changed" />

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="着色颜色" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" x:Name="TintColorBox" TextChanged="TintColorBox_TextChanged"
                                                 VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="选择" Style="{StaticResource CompactButton}"
                                                Margin="8,0,0,0" HorizontalAlignment="Stretch" Click="PickTintColor_Click" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===================== tab: position ===================== -->
                        <TabItem Header="位置与显示">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,12,8,2">
                                <StackPanel>
                                    <TextBlock Text="目标显示器" Style="{StaticResource SectionHeader}" />
                                    <ComboBox x:Name="MonitorCombo"
                                              SelectionChanged="MonitorCombo_SelectionChanged"
                                              DisplayMemberPath="DisplayLabel"
                                              HorizontalAlignment="Left"
                                              MinWidth="360" />
                                    <TextBlock Text="选择“主显示器”即跟随系统主屏；显示器被拔出时会自动回退到主屏。"
                                               Style="{StaticResource Hint}"
                                               Margin="0,8,0,18" />

                                    <TextBlock Text="位置微调" Style="{StaticResource SectionHeader}" />

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="水平偏移 (px)" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" x:Name="ScreenOffsetXSlider" Minimum="-500" Maximum="500"
                                                ValueChanged="ScreenOffsetXSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" x:Name="ScreenOffsetXText" Style="{StaticResource ValueReadout}" />
                                    </Grid>

                                    <Grid Style="{StaticResource SliderRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="垂直偏移 (px)" Style="{StaticResource FieldLabel}" />
                                        <Slider Grid.Column="1" x:Name="ScreenOffsetYSlider" Minimum="-500" Maximum="500"
                                                ValueChanged="ScreenOffsetYSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2" x:Name="ScreenOffsetYText" Style="{StaticResource ValueReadout}" />
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,14,0,14" />

                                    <TextBlock Text="启动行为" Style="{StaticResource SectionHeader}" />
                                    <CheckBox x:Name="VisibleCheck" Content="启动时显示准星"
                                              Checked="VisibleCheck_Changed" Unchecked="VisibleCheck_Changed" />
                                    <CheckBox x:Name="AutoStartCheck" Content="开机自动启动"
                                              Checked="AutoStartCheck_Changed" Unchecked="AutoStartCheck_Changed" />
                                    <CheckBox x:Name="NotifyCheck" Content="显示托盘通知"
                                              Checked="NotifyCheck_Changed" Unchecked="NotifyCheck_Changed" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===================== tab: hotkeys ===================== -->
                        <TabItem Header="快捷键">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2,12,8,2">
                                <StackPanel>
                                    <TextBlock Text="点击输入框后按下想要的组合键。按 Esc 可清除该项。"
                                               Style="{StaticResource Hint}"
                                               Margin="0,0,0,16" />

                                    <Grid x:Name="HotkeyGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="显示/隐藏" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="HotkeyToggleBox" Margin="0,4"
                                                 IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Tag="ToggleVisibility" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="默认 F8" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="切换准星" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="HotkeyCycleBox" Margin="0,4"
                                                 IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Tag="CyclePreset" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="默认 F9" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="打开设置" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="HotkeySettingsBox" Margin="0,4"
                                                 IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Tag="OpenSettings" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="默认 F10" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="退出程序" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="HotkeyExitBox" Margin="0,4"
                                                 IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Tag="Exit" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="默认 Ctrl+Alt+Q" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </Grid>

                                    <Button Content="恢复默认快捷键" Click="ResetHotkeys_Click"
                                            HorizontalAlignment="Left" Margin="0,18,0,0" />

                                    <Border x:Name="HotkeyStatusBorder"
                                            Background="#33FFB454"
                                            BorderBrush="{StaticResource Warn}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,9"
                                            Margin="0,16,0,0">
                                        <TextBlock x:Name="HotkeyStatusText"
                                                   Foreground="{StaticResource Warn}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================ footer ============================ -->
        <Border Grid.Row="2"
                Background="{StaticResource Surface1}"
                BorderBrush="{StaticResource Hairline}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Margin="0,12,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="恢复默认设置" Click="RestoreDefaults_Click" />
                    <Button Content="导入配置" Click="Import_Click" />
                    <Button Content="导出配置" Click="Export_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Click="Cancel_Click" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
